generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model FeatureFlag {
  key         String  @id
  enabled     Boolean @default(false)
  label       String
  description String?
}

model User {
  id           Int           @id @default(autoincrement())
  fullName     String        @unique
  passwordHash String
  role         String        // MANAGER | CASHIER
  lastLogin    DateTime?
  createdAt    DateTime      @default(now())
  transactions Transaction[]
  refunds      Refund[]
  backupLogs   BackupLog[]
}

model Product {
  id         Int               @id @default(autoincrement())
  sku        String            @unique
  name       String
  costCents  Int
  priceCents Int
  barcode    String?           @unique
  isPinned   Boolean           @default(false) // If true, ignore pricing tier auto-calculation
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  orderItems TransactionItem[]

  // --- Inventory (reporting) ---
  // On-hand quantity and reorder point for inventory valuation & low-stock alerts.
  // Defaults to 0; updated by sales (decrement) and InventoryAdjustment entries.
  currentOnHand  Int @default(0)
  reorderPoint   Int @default(0)
  // Category code for grouping in reports (OTC | RX | SPECIALTY | ...).
  // Mirrors the McKesson categoryCode when promoted from the catalogue.
  categoryCode   String?

  // --- Catalogue provenance (McKesson import) ---
  // origin: MANUAL | CATALOG. MANUAL rows are never read or written by a catalogue import.
  origin            String    @default("MANUAL")
  sourceItemNumber  String? // McKesson 6-digit item number — the stable link key
  lastCatalogSyncAt DateTime?
  lastSeenBatchId   Int?

  // Lifecycle — an item dropped from the catalogue is flagged, never deleted
  discontinued   Boolean   @default(false)
  discontinuedAt DateTime?

  // Field-level ownership: true means the pharmacist edits it by hand,
  // so a catalogue refresh must NOT overwrite it.
  nameOverridden    Boolean @default(false)
  costOverridden    Boolean @default(false)
  barcodeOverridden Boolean @default(false)

  inventoryAdjustments InventoryAdjustment[]

  @@index([origin])
  @@index([sourceItemNumber])
  @@index([discontinued])
  @@index([categoryCode])
}

model CatalogProduct {
  id              Int                @id @default(autoincrement())
  itemNumber      String // pos 2-7, unique within a batch
  description     String // pos 8-57, raw ALL-CAPS — never overwritten
  displayName     String // polished — see spec §4
  effectiveDate   String? // pos 58-65, YYYYMMDD
  categoryCode    String? // pos 90-94
  din             String? // pos 127-134, null when all-zero
  packSize        Int? // pos 144-149
  province        String // pos 150-152: ONT | QUE
  strength        String? // pos 153-162
  dosageForm      String? // pos 163-177
  genericCode     String? // pos 178-183
  genericName     String? // pos 184-213
  mfrPartNumber   String? // pos 214-228
  deptCode        String? // pos 232-234
  vendorCode      String? // pos 235-237
  listPriceCents  Int                @default(0) // pos 332-338
  costPriceCents  Int                @default(0) // pos 339-345
  uomGroup        String? // pos 352
  uomType         String? // pos 353
  gtinPrimary     String? // pos 355-368, check-digit validated
  gtinPrimaryNorm String? // leading zeros stripped — the scan-match key
  gtinCase        String? // pos 383-396
  gtinCaseNorm    String?
  importBatchId   Int
  importBatch     CatalogImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  deals           CatalogDeal[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([importBatchId, itemNumber])
  @@index([itemNumber])
  @@index([gtinPrimaryNorm])
  @@index([gtinCaseNorm])
  @@index([din])
  @@index([province])
  @@index([vendorCode])
}

model CatalogDeal {
  id               Int            @id @default(autoincrement())
  catalogProductId Int
  catalogProduct   CatalogProduct @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)
  dealType         String // pos 8-10
  dealNumber       String // pos 11-15
  date1            String? // pos 16-23
  date2            String? // pos 24-31
  date3            String? // pos 32-39
  date4            String? // pos 40-47
  allowanceCents   Int            @default(0) // pos 69-75
  dealPriceCents   Int            @default(0) // pos 76-82
  tierFlag         String? // pos 95

  @@index([catalogProductId])
}

model CatalogImportBatch {
  id                Int              @id @default(autoincrement())
  filename          String
  fileSizeBytes     Int
  startedAt         DateTime         @default(now())
  completedAt       DateTime?
  status            String // pending | previewing | committed | failed | rolledBack
  totalLines        Int              @default(0)
  productsNew       Int              @default(0)
  productsUpdated   Int              @default(0)
  productsUnchanged Int              @default(0)
  dealsImported     Int              @default(0)
  linesRejected     Int              @default(0)
  errorReport       String? // JSON: line numbers + reasons
  reconcileReport   String? // JSON: the committed reconciliation plan summary
  repricedCount     Int              @default(0)
  discontinuedCount Int              @default(0)
  isActive          Boolean          @default(false)
  supersededAt      DateTime?
  products          CatalogProduct[]

  @@index([isActive])
}

model Customer {
  id               Int                 @id @default(autoincrement())
  firstName        String
  lastName         String
  phone            String
  phoneNormalized  String
  address          String
  email            String?
  loyaltyEnabled   Boolean             @default(true)
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  /** Audit: user who created this customer record (User.id). Soft linkage only. */
  createdByUserId  Int?
  ledgerEntries    CreditLedgerEntry[]
  pointEvents      LoyaltyPointEvent[]
  transactions     Transaction[]

  @@index([phoneNormalized])
  @@index([lastName, firstName])
}

model CreditLedgerEntry {
  id                Int             @id @default(autoincrement())
  customerId        Int
  customer          Customer        @relation(fields: [customerId], references: [id])
  type              CreditEntryType
  amountCents       Int
  balanceAfterCents Int
  transactionId     String?
  refundId          Int?
  note              String?
  createdByUserId   Int?
  createdAt         DateTime        @default(now())

  @@index([customerId, createdAt])
  @@index([transactionId])
}

model LoyaltyPointEvent {
  id         Int              @id @default(autoincrement())
  customerId Int
  customer   Customer         @relation(fields: [customerId], references: [id])
  type       LoyaltyEventType
  points     Int
  pointsAfter Int
  transactionId String?
  note       String?
  createdAt  DateTime         @default(now())

  @@index([customerId, createdAt])
  @@index([transactionId])
}

enum CreditEntryType {
  FUNDS_ADDED
  SALE_CHARGE
  MANUAL_ADJUSTMENT
  REFUND_CREDIT
}

enum LoyaltyEventType {
  EARNED
  REDEEMED
  MANUAL_ADJUSTMENT
  EXPIRED
}

model PricingTier {
  id            String  @id @default(uuid())
  minCostCents  Int
  maxCostCents  Int?
  markupPercent Float
  orderIndex    Int     @default(0)
}

model Transaction {
  id             String            @id @default(uuid())
  receiptNumber  String            @unique
  status         String            @default("COMPLETED") // COMPLETED, PARKED, VOIDED, REFUNDED
  subtotalCents Int
  taxCents       Int
  totalCents     Int
  tenderType     String            @default("CASH") // CASH, CARD, E_TRANSFER, PHARMACY_CREDIT, SPLIT
  tenderedCents  Int
  changeCents    Int
  voidReason     String?
  customerId     Int?
  customer       Customer?         @relation(fields: [customerId], references: [id])
  tabAmountCents Int?               @default(0)
  /** Additional surcharge cents for credit card transactions (e.g. 2% fee). */
  surchargeCents Int?               @default(0)
  /** Customer email for E-Transfer (optional, shown on receipt). */
  email          String?
  userId         Int?
  user           User?             @relation(fields: [userId], references: [id])
  /** Audit: the cashier who rang up the sale (User.id). */
  cashierId              Int?
  /** Audit: manager who authorized a void (User.id). */
  voidedByUserId         Int?
  /** Audit: manager who issued a discount (User.id). */
  discountIssuedByUserId Int?
  /** Card refund reversal target: the processor's charge id and the card's last 4 digits, captured at charge time. */
  processorTransactionId String?
  cardLast4               String?
  /** Whole-bill discount applied at checkout (see Discount model for the audit row). */
  billDiscountCents       Int?     @default(0)
  items          TransactionItem[]
  refunds        Refund[]
  discounts      Discount[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // --- Reporting-focused helper columns (spec §4) ---
  // category mirrors the dominant product category for easy grouping;
  // saleType distinguishes normal sales from returns/adjustments;
  // discountApplied captures the total discount cents applied to this sale.
  category        String?
  saleType        SaleType        @default(NORMAL)
  discountApplied Int?

  @@index([createdAt])
  @@index([status])
  @@index([customerId])
  @@index([category])
}

model TransactionItem {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     Int
  product       Product     @relation(fields: [productId], references: [id])
  quantity      Int
  costCents     Int
  unitPriceCents Int
  /** Per-item discount applied at checkout (see Discount model for the audit row). */
  discountCents Int?        @default(0)
  totalCents    Int
  isVoided      Boolean     @default(false)
  /** Whether HST was charged on this line item. Defaults to true. */
  hstApplied    Boolean     @default(true)

  @@index([transactionId])
  @@index([productId])
}

/// A refund issued against a past sale — cash/card/e-transfer/tab-credit.
/// Card refunds reverse the original charge via the payment adapter; tab-credit
/// refunds also produce a CreditLedgerEntry. See pharmacy-pos-feature-spec.md.
model Refund {
  id                Int          @id @default(autoincrement())
  transactionId     String
  transaction       Transaction  @relation(fields: [transactionId], references: [id])
  type              RefundType
  amountCents       Int
  reason            String?
  /** For E_TRANSFER refunds — where the manager must manually send funds. */
  customerEmail     String?
  /** Processor's refund id, for CARD refunds. */
  providerRefundId  String?
  refundedByUserId  Int
  refundedBy        User         @relation(fields: [refundedByUserId], references: [id])
  status            RefundStatus
  createdAt         DateTime     @default(now())

  @@index([transactionId])
  @@index([refundedByUserId])
}

enum RefundType {
  CASH
  CARD
  E_TRANSFER
  TAB_CREDIT
}

enum RefundStatus {
  COMPLETED
  PENDING
}

/// Audit trail for a discount applied at checkout — one row per item discount,
/// plus one BILL row if a whole-bill discount was applied.
model Discount {
  id              Int          @id @default(autoincrement())
  transactionId   String
  transaction     Transaction  @relation(fields: [transactionId], references: [id])
  type            DiscountType
  /** TransactionItem.id — set when type is ITEM. */
  itemId          String?
  amountCents     Int
  originalCents   Int
  finalCents      Int
  reason          String?
  appliedByUserId Int?
  createdAt       DateTime     @default(now())

  @@index([transactionId])
  @@index([appliedByUserId])
}

enum DiscountType {
  ITEM
  BILL
}

// --- Reporting enums & models (spec §4) ---

enum SaleType {
  NORMAL
  RETURN
  ADJUSTMENT
}

/// Audit trail for full-data backups (spec: docs/data-backup-system-spec.md).
/// One row per backup attempt, success or failure; McKesson catalogue tables
/// are never included in the backup this row describes.
model BackupLog {
  id                Int          @id @default(autoincrement())
  timestamp         DateTime     @default(now())
  backupPath        String
  driveName         String
  drivePath         String
  backupSizeBytes   Int
  dataSnapshot      String // JSON — same shape as backup-metadata.json's dataSnapshot
  initiatedByUserId Int
  initiatedBy       User         @relation(fields: [initiatedByUserId], references: [id])
  status            BackupStatus
  errorMessage      String?

  @@index([initiatedByUserId])
  @@index([timestamp])
}

enum BackupStatus {
  SUCCESS
  FAILED
  PARTIAL
}

/// Manual inventory corrections (physical count, damage, expiry, stocking).
/// Sales decrement `Product.currentOnHand` directly; this model records the
/// out-of-band adjustments that don't flow through a sale.
model InventoryAdjustment {
  id               Int      @id @default(autoincrement())
  productId        Int
  product          Product  @relation(fields: [productId], references: [id])
  quantityDelta    Int // positive = stock in, negative = stock out
  reason           String // "physical count correction", "damaged", "expired", "stocking", etc.
  adjustedByUserId Int?
  createdAt        DateTime @default(now())

  @@index([productId, createdAt])
}
